/dts-v1/;
#include <atmel/samd21g17d.dtsi>

/ {
    model = "SAM D21 Curiosity Nano";
	compatible = "atmel,samd21g17d";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };

    aliases {
        led0 = &led0;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&portb 10 GPIO_ACTIVE_HIGH>;
            label = "LED0";
        };
    };
 };
 
&cpu0 {
	clock-frequency = <48000000>;
};