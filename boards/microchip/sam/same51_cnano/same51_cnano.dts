/dts-v1/;
#include <microchip/sam/sam_d5x_e5x/atsame51/atsame51j20a.dtsi>
#include "same51_cnano-pinctrl.dtsi"
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mchp_sam_d5x_e5x_adc.h>

/ {
	model = "SAM E51 Curiosity Nano";
	compatible = "microchip,atsame51j20a", "microchip,same51";

	chosen {
		zephyr,console = &sercom5;
		zephyr,shell-uart = &sercom5;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash-controller = &nvmctrl;
		zephyr,entropy = &trng;
	};

	aliases {
		led0 = &led0;
		pwm-led0 = &pwm_led0;
		sw0 = &button0;
		i2c-0 = &sercom2;
		spi-0 = &sercom1;
		rtc = &rtc;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&porta 14 GPIO_ACTIVE_LOW>;
			label = "LED0";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&tcc2 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&porta 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&cpu0 {
	clock-frequency = <120000000>;
};

&clock {
	xosc32k: xosc32k {
		xosc32k-xtal-en = <1>;
		xosc32k-startup-time = <62>;
		xosc32k-gain-mode = "standard";
		xosc32k-en = <1>;
		xosc32k-32khz-en = <1>;
		xosc32k-1khz-en = <1>;
	};

	dfll: dfll {
		dfll-en = <0>;
	};

	fdpll: fdpll {
		/* 32768 Hz * (3661 + 1 + 4 / 32) = 120.0005 MHz */
		fdpll0 {
			subsystem = <CLOCK_MCHP_FDPLL_ID_FDPLL0>;
			fdpll-divider-ratio-int = <3661>;
			fdpll-divider-ratio-frac = <4>;
			fdpll-src = "xosc32k";
			fdpll-en = <1>;
		};
	};

	rtcclock: rtcclock {
		/* XOSC1K */
		rtc-src = <4>;
	};

	gclkgen: gclkgen {
		/* 120 MHz CPU clock */
		gclkgen0 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN0>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "fdpll0";
			gclkgen-en = <1>;
		};

		/* 60 MHz peripheral clock */
		gclkgen1 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN1>;
			gclkgen-div-factor = <2>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "fdpll0";
			gclkgen-en = <1>;
		};

		/* 12 MHz DAC clock */
		gclkgen2 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN2>;
			gclkgen-div-factor = <10>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "fdpll0";
			gclkgen-en = <1>;
		};
	};

	gclkperiph: gclkperiph {
		sercom1 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM1_CORE>;
			gclkperiph-src = "gclk1";
		};

		sercom2 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM2_CORE>;
			gclkperiph-src = "gclk1";
		};

		sercom4 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM4_CORE>;
			gclkperiph-src = "gclk1";
		};

		sercom5 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM5_CORE>;
			gclkperiph-src = "gclk1";
		};

		adc0 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_ADC0>;
			gclkperiph-src = "gclk1";
		};

		dac {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_DAC>;
			gclkperiph-src = "gclk2";
		};
	};
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0x00010000>;
			read-only;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 0x00070000>;
		};

		slot1_partition: partition@80000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00080000 0x00070000>;
		};

		storage_partition: partition@f0000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000f0000 0x00010000>;
		};
	};
};

&porta {
	status = "okay";
};

&portb {
	status = "okay";
};

&rtc {
	prescaler = <1024>;
	status = "okay";
};

&wdt {
	status = "okay";
};

&trng {
	status = "okay";
};

&sercom1 {
	compatible = "microchip,sercom-g1-spi";
	dipo = <3>;
	dopo = <0>;
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&porta 18 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&sercom1_spi_default>;
	pinctrl-names = "default";
	dmas = <&dmac 7 0x6>, <&dmac 8 0x7>;
	dma-names = "rx", "tx";
	status = "okay";
};

&sercom2 {
	compatible = "microchip,sercom-g1-i2c";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&sercom2_i2c_default>;
	pinctrl-names = "default";
	dmas = <&dmac 5 0x8>, <&dmac 6 0x9>;
	dma-names = "rx", "tx";
	status = "okay";
};

&sercom4 {
	compatible = "microchip,sercom-g1-uart";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <1>;
	txpo = <0>;
	pinctrl-0 = <&sercom4_uart_default>;
	pinctrl-names = "default";
	dmas = <&dmac 3 0xc>, <&dmac 4 0xd>;
	dma-names = "rx", "tx";
	status = "okay";
};

&sercom5 {
	compatible = "microchip,sercom-g1-uart";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <1>;
	txpo = <0>;
	pinctrl-0 = <&sercom5_uart_default>;
	pinctrl-names = "default";
	dmas = <&dmac 1 0xe>, <&dmac 2 0xf>;
	dma-names = "rx", "tx";
	status = "okay";
};

&tcc2 {
	compatible = "microchip,tcc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tcc2_pwm_default>;
	pinctrl-names = "default";
	prescaler = <8>;
	status = "okay";
};

&adc0 {
	/* ADC clock = GCLK / prescaler (60 MHz / 4 = 15 MHz) */
	prescaler = <4>;
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&dac {
	refsel = "vdd_ana";
	pinctrl-0 = <&dac_default>;
	pinctrl-names = "default";
	status = "okay";
};
